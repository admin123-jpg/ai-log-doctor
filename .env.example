# ==========================================================
# 配置说明：把本文件复制一份，重命名为 .env，然后按需填写
# 注意：.env 已在 .gitignore 里，不会被提交到 GitHub（避免密钥泄露）
# ==========================================================

# ---------- 大模型配置 ----------
# 留空则自动进入 Mock 模式：用内置规则库生成诊断结论，
# 整条链路（采集→检测→RAG→诊断→入库→前端）依然能完整跑通。
LLM_API_KEY=

# 接口地址（OpenAI 兼容格式）
#   DeepSeek:     https://api.deepseek.com
#   通义千问:      https://dashscope.aliyuncs.com/compatible-mode/v1
#   OpenAI:       https://api.openai.com/v1
LLM_BASE_URL=https://api.deepseek.com

# 模型名称
#   DeepSeek:  deepseek-chat
#   通义千问:   qwen-plus
#   OpenAI:    gpt-4o-mini
LLM_MODEL=deepseek-chat

# ---------- Embedding（向量化）配置 ----------
# 不填则自动复用 LLM_API_KEY
EMBED_API_KEY=
# 通义千问的 embedding 模型名：text-embedding-v3
EMBED_MODEL=text-embedding-v3

# ---------- 运行模式 ----------
# true = 强制使用 Mock 模式（即使配了 API Key 也不调真实模型）
MOCK_MODE=false

# ---------- 向量库后端 ----------
# auto   = 自动选择（装了 chromadb 就用 chroma，否则用内存版）
# chroma = 强制用 Chroma
# simple = 强制用内存版（零依赖，推荐新手先用这个）
VECTOR_BACKEND=auto

# ---------- 日志采集 ----------
# 要监控的容器名，多个用英文逗号分隔（需与 docker-compose.yml 的服务名一致）
WATCH_CONTAINERS=demo-nginx,demo-app,demo-mysql
# 每次采集多少行日志
LOG_TAIL=100

# ---------- RAG 参数 ----------
# 检索时返回几条参考资料
TOP_K=3

# ---------- Web 服务 ----------
API_HOST=127.0.0.1
API_PORT=8000
